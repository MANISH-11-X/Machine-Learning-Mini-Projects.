#Customer Purchase Predictor
from sklearn.ensemble import RandomForestClassifier
import numpy as np

X = np.array([
    [20, 20000 , 1 ,30], #Age , Income , Purchases , Spending Score
    [24, 25000 , 4 ,35],  
    [28, 30000 , 2 ,40],
    [32, 40000 , 3 ,45],
    [36, 35000 , 3 ,50],
    [40, 40000 , 4 ,55],
    [44, 50000 , 8 ,60],
])

y = np.array([0,0,0,1,1,1,1])

model = RandomForestClassifier(n_estimators=100, random_state=42)
#n_estimators : It means how many Decision Trees will be Created Inside the Random Forest, more decision trees more accuracy.
# random_states : Random Forest Uses Randomness when creating its trees. Whenever you randomly select things, use the same random pattern every time.abs

model.fit(X, y)

age = int(input("Enter Your age :"))
income = int(input("Enter Your Income :"))
purchases = int(input("Enter Number Of Purchases :"))
score = int(input("Enter Spending Score :"))

prediction = model.predict([
    [age,income,purchases,score]
])

print(prediction)


