#Student Marks Predictor using Linear Regression
from sklearn.linear_model import LinearRegression
import numpy as np

X = np.array([[1],[2],[3],[4],[5]]) #Study Hours
y = np.array([20,35,50,65,80]) #Marks

model = LinearRegression()

model.fit(X , y)

prediction = model.predict([[6]])

print(prediction) #[95.]


#Check whether a student Pass or Fail using Logistic Regression
from sklearn.linear_model import LogisticRegression
import numpy as np

X = np.array([[1],[2],[3],[4],[5]]) #Study Hours
y = np.array(['Fail','Fail','Pass','Pass','Pass']) #Pass or Fail 

model = LogisticRegression()

model.fit(X , y)

prediction = model.predict([[6]])

print(prediction)  #['Pass']
