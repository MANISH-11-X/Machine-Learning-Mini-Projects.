#Car Price Predictor Using Multiple Regression
from sklearn.linear_model import LinearRegression
import numpy as np


X = np.array([
    [1,10000,1000], #Age , Mileage , Engine(CC)
    [2,20000,1000],
    [3,30000,2000],
    [4,40000,2000],
    [5,50000,3000],
    [6,60000,3000],
    [7,70000,4000],
])

y = np.array([7.5,6.8,6.0,5.2,4.8,4.2,3.8]) #Price in Lakhs

model = LinearRegression()

model.fit(X , y)

prediction = model.predict([[8,80000,4000]])

print(prediction) #[2.9]
